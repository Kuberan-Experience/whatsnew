# --- Neon Postgres -----------------------------------------------------------
# Pooled connection string (…-pooler.…neon.tech). Used at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/whatsnew?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct connection string (no -pooler). Used by `prisma migrate` only.
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/whatsnew?sslmode=require"

# --- Auth --------------------------------------------------------------------
# Any long random string: `openssl rand -base64 48`
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# --- GitHub webhook ----------------------------------------------------------
# Must match the secret configured on the repo webhook.
GITHUB_WEBHOOK_SECRET="change-me"

# --- Anthropic (release-note polish; optional — app works without it) --------
ANTHROPIC_API_KEY=""

# --- SendGrid ----------------------------------------------------------------
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="release-notes@yourdomain.com"
SENDGRID_FROM_NAME="Product Release Notes"

# --- Misc --------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:5173"
APP_BASE_URL="http://localhost:5173"
PORT=3001
