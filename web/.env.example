# Copy to .env.local and fill in. .env.local is gitignored and read
# server-side only — never bundled into client JavaScript.

# Required to generate release notes. console.anthropic.com > API keys.
ANTHROPIC_API_KEY=

# Optional. Only for PRs in a PRIVATE repo, or to lift GitHub's 60 req/hr
# anonymous limit. Fine-grained token, Pull requests: Read-only, is enough.
GITHUB_TOKEN=

# Required to actually send email. Without these the app still posts in-app
# notifications and says plainly that no email was sent.
#   SENDGRID_API_KEY    app.sendgrid.com > Settings > API Keys (Mail Send permission)
#   SENDGRID_FROM_EMAIL must be a verified Single Sender, or on a domain you
#                       have authenticated in SendGrid. An unverified address
#                       is rejected with a 403.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Product Release Notes
